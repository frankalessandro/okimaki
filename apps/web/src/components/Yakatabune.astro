---
/**
 * Yakatabune (屋形船): barca japonesa con techo y faroles, en silueta a contraluz.
 * Solo SVG + CSS: navega, se mece, los faroles titilan y el reflejo ondula. Sin JavaScript.
 */
interface Props {
  class?: string
}
const { class: clase = '' } = Astro.props
const ventanas = [44, 70, 96, 122, 148, 174]
---

<div class:list={['yakatabune', clase]} aria-hidden="true">
  <svg viewBox="0 0 260 140" class="block w-full overflow-visible">
    <defs>
      <linearGradient id="yk-casco" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4a2e1b"></stop>
        <stop offset=".55" stop-color="#24150c"></stop>
        <stop offset="1" stop-color="#110a06"></stop>
      </linearGradient>
      <linearGradient id="yk-shoji" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffe3a8"></stop>
        <stop offset="1" stop-color="#e79a45"></stop>
      </linearGradient>
      <linearGradient id="yk-techo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2b1d14"></stop>
        <stop offset="1" stop-color="#0f0a07"></stop>
      </linearGradient>
      <radialGradient id="yk-halo" cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#f3b866" stop-opacity=".55"></stop>
        <stop offset="1" stop-color="#f3b866" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="yk-farol" cx=".45" cy=".4" r=".6">
        <stop offset="0" stop-color="#ffb08a"></stop>
        <stop offset=".6" stop-color="#d23b2a"></stop>
        <stop offset="1" stop-color="#7d1810"></stop>
      </radialGradient>
      <linearGradient id="yk-fundido" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".9"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <mask id="yk-mascara">
        <rect x="0" y="90" width="260" height="50" fill="url(#yk-fundido)"></rect>
      </mask>

    </defs>

    <!-- Halo cálido detrás: hace legible la silueta sobre el negro -->
    <ellipse cx="122" cy="58" rx="130" ry="46" fill="url(#yk-halo)" class="halo"></ellipse>

    <g class="mecer">
      <g id="yk-barca">
        <!-- Barquero con kasa y pértiga -->
        <path d="M33 38 L4 104" stroke="#1a110b" stroke-width="2" stroke-linecap="round"></path>
        <path d="M18 70 L19 52 Q22 47 26 52 L27 70 Z" fill="#140d08"></path>
        <path d="M21 56 L31 46 M25 58 L32 50" stroke="#140d08" stroke-width="2.4" stroke-linecap="round"></path>
        <circle cx="22.5" cy="45.5" r="3.4" fill="#140d08"></circle>
        <path d="M13 44.5 L22.5 36.5 L32 44.5 Q22.5 46.5 13 44.5 Z" fill="#2a1c12" stroke="#c9a24b" stroke-opacity=".55" stroke-width=".6"></path>

        <!-- Cabina: postes y shoji iluminados -->
        <rect x="40" y="44" width="160" height="27" fill="#120b07"></rect>
        {
          ventanas.map((x) => (
            <g>
              <rect x={x} y="47" width="22" height="19" fill="url(#yk-shoji)" class="shoji"></rect>
              <path d={`M${x} 56.5 H${x + 22} M${x + 11} 47 V66 M${x} 51.5 H${x + 22} M${x} 61.5 H${x + 22}`} stroke="#6b3d16" stroke-opacity=".45" stroke-width=".7"></path>
            </g>
          ))
        }
        <path d="M40 66.5 H200" stroke="#2a1a10" stroke-width="2"></path>

        <!-- Techo curvo con aleros -->
        <path d="M26 45 L50 33 Q120 18 190 33 L214 45 Q120 31 26 45 Z" fill="url(#yk-techo)"></path>
        <path d="M26 45 Q120 31 214 45" fill="none" stroke="#e6cf8e" stroke-opacity=".75" stroke-width=".9"></path>
        <path d="M50 33 Q120 18 190 33" fill="none" stroke="#e6cf8e" stroke-opacity=".35" stroke-width=".7"></path>

        <!-- Faroles de los aleros y de proa -->
        <path d="M30 44.5 V48 M210 44.5 V48" stroke="#1a110b" stroke-width=".8"></path>
        <g class="farol"><ellipse cx="30" cy="53.5" rx="4.4" ry="5.8" fill="url(#yk-farol)"></ellipse><path d="M26.2 48.6 H33.8 M26.2 58.4 H33.8" stroke="#1a110b" stroke-width="1.3"></path></g>
        <g class="farol" style="animation-delay:-.8s"><ellipse cx="210" cy="53.5" rx="4.4" ry="5.8" fill="url(#yk-farol)"></ellipse><path d="M206.2 48.6 H213.8 M206.2 58.4 H213.8" stroke="#1a110b" stroke-width="1.3"></path></g>
        <path d="M240 58 L246 28" stroke="#1a110b" stroke-width="1.4" stroke-linecap="round"></path>
        <path d="M246 28 L252 30 V33" stroke="#1a110b" stroke-width=".8" fill="none"></path>
        <g class="farol" style="animation-delay:-1.6s"><ellipse cx="252" cy="38.5" rx="3.6" ry="4.8" fill="url(#yk-farol)"></ellipse><path d="M249 34.4 H255 M249 42.6 H255" stroke="#1a110b" stroke-width="1.1"></path></g>

        <!-- Casco de madera con proa alta -->
        <path d="M12 70 H214 C228 70 239 63 248 52 L253 50 C251 61 245 73 233 82 C226 88 214 90 200 90 H42 C29 90 18 84 13 77 Z" fill="url(#yk-casco)"></path>
        <path d="M12 70 H214 C228 70 239 63 248 52 L253 50" fill="none" stroke="#e6cf8e" stroke-opacity=".8" stroke-width="1.1" stroke-linecap="round"></path>
        <path d="M16 77.5 H238 M24 84 H228" stroke="#c9a24b" stroke-opacity=".14" stroke-width=".7"></path>
      </g>
    </g>

    <!-- Reflejo comprimido y desvanecido -->
    <g mask="url(#yk-mascara)" class="reflejo">
      <use href="#yk-barca" transform="translate(0 135) scale(1 -0.5)" opacity=".38"></use>
      <path d="M50 96 H86 M100 99 H140 M152 95 H190 M70 104 H110 M128 107 H170" stroke="#f3c77a" stroke-opacity=".5" stroke-width="1.2" stroke-linecap="round" class="destellos"></path>
    </g>

    <!-- Estela detrás de la popa -->
    <g class="estela" fill="none" stroke="#e6cf8e" stroke-linecap="round">
      <path d="M8 92 Q-6 94 -22 93" stroke-opacity=".35" stroke-width="1"></path>
      <path d="M2 97 Q-14 100 -34 99" stroke-opacity=".22" stroke-width="1"></path>
      <path d="M232 91 Q246 92 258 90" stroke-opacity=".3" stroke-width=".9"></path>
    </g>
  </svg>
</div>

<style>
  .yakatabune {
    filter: drop-shadow(0 0 18px rgb(243 184 102 / 0.18));
  }
  .mecer {
    transform-box: fill-box;
    transform-origin: 50% 85%;
    animation: mecer 4.8s ease-in-out infinite;
  }
  .reflejo {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: ondular 3.2s ease-in-out infinite;
  }
  .farol {
    animation: titilar 2.6s ease-in-out infinite;
  }
  .shoji {
    animation: titilar 5s ease-in-out infinite;
  }
  .halo {
    animation: titilar 6s ease-in-out infinite;
  }
  .destellos {
    stroke-dasharray: 14 10;
    animation: destellar 2.4s linear infinite;
  }
  .estela {
    animation: estela 2.8s ease-out infinite;
  }
  @keyframes mecer {
    0%,
    100% {
      transform: translateY(0) rotate(-0.8deg);
    }
    50% {
      transform: translateY(2.5px) rotate(0.8deg);
    }
  }
  @keyframes ondular {
    0%,
    100% {
      transform: scaleX(1) skewX(0);
      opacity: 0.9;
    }
    50% {
      transform: scaleX(1.015) skewX(-2deg);
      opacity: 0.65;
    }
  }
  @keyframes titilar {
    0%,
    100% {
      opacity: 1;
    }
    40% {
      opacity: 0.82;
    }
    55% {
      opacity: 0.95;
    }
  }
  @keyframes destellar {
    to {
      stroke-dashoffset: -48;
    }
  }
  @keyframes estela {
    0% {
      opacity: 0;
      transform: translateX(6px);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(-14px);
    }
  }
</style>
