---
import Base from '../layouts/Base.astro'
import ReservaFlow from '../components/ReservaFlow'
---

<Base
  titulo="Reserva en Okimaki369 · Sushi flotante en Cali"
  descripcion="Reserva tu mesa en Okimaki369, sushi flotante y cocina de fusión asiática en San Vicente, Cali."
>
  <div class="mb-6 text-center">
    <h1 class="text-3xl text-ivory-50">Reserva tu mesa</h1>
    <p class="mt-2 text-sm text-ivory-300">Elige el día, la tanda y paga para confirmar.</p>
  </div>
  <ReservaFlow client:load />
</Base>
