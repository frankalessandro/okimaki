---
import Base from '../layouts/Base.astro'
import Escena from '../components/Escena.astro'

const letras = 'OKIMAKI'.split('')
const pasos = [
  { kanji: '食', titulo: 'Experiencia', texto: 'Menú, precio y días' },
  { kanji: '時', titulo: 'Fecha y hora', texto: 'Solo tandas con cupo' },
  { kanji: '名', titulo: 'Tus datos', texto: 'Nombre y celular' },
  { kanji: '払', titulo: 'Pago', texto: 'Transferencia y WhatsApp' },
]
---

<Base
  titulo="Reserva en Okimaki369 · Sushi flotante en Cali"
  descripcion="Reserva tu mesa en Okimaki369, sushi flotante y cocina de fusión asiática en San Vicente, Cali. Elige tu experiencia, tu tanda y paga en línea."
>
  <!-- Una sola pantalla: alto del viewport menos el encabezado (5rem); crece solo si no cabe. -->
  <section class="hero relative flex min-h-[calc(100svh-5rem)] flex-col overflow-hidden" aria-labelledby="titulo-hero">
    <Escena kana="おきまき" sub="369" />

    <div class="relative mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-4 pt-2 pb-28 text-center sm:pb-40">
      <!-- Marca dentro del ensō -->
      <div class="relative grid place-items-center">
        <svg viewBox="0 0 100 100" class="enso-hero absolute size-[15rem] text-gold-400 sm:size-[19rem]" aria-hidden="true">
          <defs>
            <linearGradient id="oro" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--color-gold-200)"></stop>
              <stop offset=".5" stop-color="var(--color-gold-400)"></stop>
              <stop offset="1" stop-color="var(--color-gold-600)"></stop>
            </linearGradient>
          </defs>
          <path
            d="M78 22C69.5 13.5 55.4 10 43 13.6 25.4 18.7 13.4 36.4 15.8 54.6c2.4 18.4 19.5 32 38 30.9 17.6-1 31.7-15.5 32.4-33.1.3-7.3-1.8-14.4-5.8-20.3"
            fill="none"
            stroke="url(#oro)"
            stroke-width="2.2"
            stroke-linecap="round"
            pathLength="1"></path>
        </svg>

        <div class="relative py-12 sm:py-16">
          <p class="entrada text-[0.6rem] font-bold tracking-[0.45em] text-gold-400 uppercase" style="--d:.2s">Sushi flotante · Cali</p>
          <h1 id="titulo-hero" class="mt-3 font-display text-[2.6rem] leading-none font-bold tracking-[0.12em] text-ivory-50 sm:text-[3.4rem]">
            <span class="sr-only">Okimaki 369</span>
            <span aria-hidden="true" class="inline-flex overflow-hidden pb-1">
              {letras.map((l, i) => <span class="letra inline-block" style={`--d:${0.45 + i * 0.07}s`}>{l}</span>)}
            </span>
          </h1>
          <p aria-hidden="true" class="entrada mt-1.5 flex items-center justify-center gap-3 font-display text-lg tracking-[0.6em] text-gold-300" style="--d:1.1s">
            <span class="h-px w-7 bg-linear-to-r from-transparent to-gold-400"></span>
            369
            <span class="h-px w-7 bg-linear-to-l from-transparent to-gold-400"></span>
          </p>
        </div>
      </div>

      <p class="entrada mt-1 font-display text-xl leading-snug text-ivory-50 sm:text-2xl" style="--d:1.4s">
        El sabor que navega <em class="text-gold-300 not-italic">hasta ti.</em>
      </p>

      <div class="entrada mt-6 flex w-full max-w-xs flex-col items-center gap-1" style="--d:1.6s">
        <a
          href="/reservar"
          class="brillo group inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-2xl bg-linear-to-b from-gold-300 via-gold-400 to-gold-600 px-6 font-bold tracking-wide text-carbon-950 shadow-[0_14px_40px_-12px_var(--color-gold-500),inset_0_1px_0_rgb(255_255_255/.5)] transition active:scale-[.97]"
        >
          Reservar mi mesa
          <svg viewBox="0 0 24 24" class="size-5 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h15.5M13.5 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="/mi-reserva" class="inline-flex min-h-11 items-center justify-center text-sm text-ivory-300 underline decoration-gold-500/40 underline-offset-[6px] transition hover:text-gold-200">
          Ya reservé: ver mi reserva
        </a>
      </div>

      <!-- Cómo funciona, en una fila: kanji, paso y una línea -->
      <ol class="entrada mt-7 grid w-full max-w-2xl grid-cols-4" style="--d:1.9s" aria-label="Cómo reservar">
        {
          pasos.map((p, i) => (
            <li class="relative flex flex-col items-center px-1">
              {i > 0 && <span aria-hidden="true" class="absolute top-5 right-1/2 left-[-50%] h-px bg-linear-to-r from-gold-500/10 via-gold-500/40 to-gold-500/10" />}
              <span class="relative grid size-10 place-items-center rounded-full border border-gold-500/40 bg-carbon-950 font-pincel text-lg text-gold-200" aria-hidden="true">
                {p.kanji}
              </span>
              <span class="mt-2 text-[0.7rem] leading-tight font-bold text-ivory-100 sm:text-xs">
                <span class="sr-only">Paso {i + 1}: </span>
                {p.titulo}
              </span>
              <span class="mt-0.5 hidden text-[0.72rem] leading-snug text-ivory-500 sm:block">{p.texto}</span>
            </li>
          ))
        }
      </ol>
    </div>

  </section>

  <style>
    .enso-hero path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: trazo 2.2s var(--ease-suave) 0.15s forwards;
      filter: drop-shadow(0 0 12px color-mix(in oklab, var(--color-gold-400) 45%, transparent));
    }
    .letra {
      animation: letra 1s var(--ease-suave) var(--d) both;
    }
    .entrada {
      animation: aparecer 1s var(--ease-suave) var(--d) backwards;
    }
    @keyframes letra {
      from {
        opacity: 0;
        transform: translateY(105%) rotate(6deg);
        filter: blur(4px);
      }
    }
  </style>
</Base>
