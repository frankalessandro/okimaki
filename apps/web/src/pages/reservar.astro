---
import Base from '../layouts/Base.astro'
import Escena from '../components/Escena.astro'
import ReservaFlow from '../components/ReservaFlow'
---

<Base
  titulo="Reservar · Okimaki369"
  descripcion="Reserva tu mesa en Okimaki369: elige tu experiencia, la fecha y la hora, y paga para confirmar."
>
  <!-- La estética del inicio sin el río: abajo ya flota la barca con el resumen de la reserva. -->
  <section class="relative min-h-[calc(100svh-5rem)] overflow-hidden">
    <Escena kana="おきまき" sub="369" rio={false} kanaSoloEscritorio />
    <div class="relative mx-auto max-w-5xl px-4 pt-2 pb-6 sm:px-6">
      <h1 class="sr-only">Reserva tu mesa en Okimaki369</h1>
      <ReservaFlow client:load />
    </div>
  </section>
</Base>
